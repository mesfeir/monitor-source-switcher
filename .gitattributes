# Normalise line endings: LF in the repository, native in the working copy.
# Keeps a Windows-authored C# project cloneable without CRLF churn.
* text=auto

*.cs       text diff=csharp
*.csproj   text
*.md       text
*.html     text
*.json     text
*.cmd      text eol=crlf
*.bat      text eol=crlf

*.png      binary
*.ico      binary
